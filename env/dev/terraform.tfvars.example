# プロジェクト基本情報
project    = "terraform-hands-on"
env        = "dev"
aws_region = "ap-northeast-1"

# ネットワーク設定
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
availability_zones   = ["ap-northeast-1a", "ap-northeast-1c"]
nat_gateway_count    = 1

# ECS
app_image_url    = "xxxxx.dkr.ecr.ap-northeast-1.amazonaws.com/ec-api"
app_image_tag    = "latest"
flyway_image_url = "xxxxx.dkr.ecr.ap-northeast-1.amazonaws.com/flyway"
flyway_image_tag = "latest"

# RDS
rds_identifier    = "terraform-hands-on-dev"
rds_database_name = "terraform_hands_on_dev_db"

# CI/CD
github_repository = "xxx/xxx"
github_branch     = "main"
