# プロジェクト基本情報
project    = "terraform-hands-on"
env        = "staging"
aws_region = "ap-northeast-1"

# ネットワーク設定
vpc_cidr                    = "10.1.0.0/16"
public_subnet_cidrs         = ["10.1.1.0/24", "10.1.2.0/24"]
private_subnet_cidrs        = ["10.1.11.0/24", "10.1.12.0/24"]
availability_zones          = ["ap-northeast-1a", "ap-northeast-1c"]
nat_gateway_count           = 1 # コストとのバランスでstagingは1台のままとする例
vpc_flow_log_retention_days = 180

# ECS
app_image_url    = "xxxxx.dkr.ecr.ap-northeast-1.amazonaws.com/ec-api"
app_image_tag    = "latest"
flyway_image_url = "xxxxx.dkr.ecr.ap-northeast-1.amazonaws.com/flyway"
flyway_image_tag = "latest"
desired_count    = 2
min_capacity     = 2
max_capacity     = 6

# RDS
rds_identifier     = "terraform-hands-on-staging-db"
rds_database_name  = "terraform_hands_on_staging_db"
rds_instance_class = "db.t3.small"
rds_multi_az       = true

# 監視・コスト管理
monthly_limit_usd   = 150
notification_emails = ["staging-team@example.com"]

# ALB
enable_deletion_protection = true

# CI/CD
github_repository = "xxx/xxx"
github_branch     = "main"
